# =============================================================================
# Variables de entorno del admin (Vite).
# Copiar este archivo a `.env.local` y completar antes de hacer `npm run dev`.
# =============================================================================

# URL del backend Hono (backend de pagos). Su dev-server escucha en :3000
# por default. Si lo moviste, ajustar aca.
VITE_BACKEND_URL=http://localhost:3000

# Supabase (obligatorio).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Bucket de Supabase Storage donde el onboarding guarda los documentos (frente/dorso/selfie/servicio).
# La columna documentos.url suele guardar solo el nombre del archivo, así que se
# resuelve contra este bucket (URL firmada si es privado, o pública si es público).
VITE_STORAGE_BUCKET=kyc
